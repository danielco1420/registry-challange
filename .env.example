# Copy to .env and adjust. Never commit .env.
# All variables are optional; unset or empty values use the defaults below.
# Validated at startup by app/server/config.server.ts: numbers are whole
# numbers (TTLs and TRUST_PROXY_HOPS >= 0, everything else >= 1; *_MS at most
# 2147483647),
# DOCKERHUB_BASE_URL and PUBLIC_ORIGIN are bare http(s) origins, and an invalid
# value aborts startup.

# The origin browsers use to reach the app, e.g. https://registry.example.com.
# Set it behind a reverse proxy that terminates TLS: POST /theme rejects any
# Origin header other than this one. Unset (the default), it accepts only the
# origin of the request URL the server sees, which behind such a proxy is
# http:// and would refuse every theme change. X-Forwarded-* is never trusted.
PUBLIC_ORIGIN=

# Upstream
DOCKERHUB_BASE_URL=https://hub.docker.com
UPSTREAM_TIMEOUT_MS=8000

# Server-side cache TTLs (seconds)
CACHE_TTL_POPULAR=600
CACHE_TTL_SEARCH=60
CACHE_TTL_REPO=300
CACHE_TTL_TAGS=120
CACHE_TTL_PUBLISHER=3600
CACHE_MAX_ENTRIES=1000

# Per-client rate limiting on our proxy
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Number of reverse proxies in front of the app (0-10). The client IP is read
# from X-Forwarded-For only when this is above 0: the entry this many hops from
# the right. Set it to match your deployment (e.g. 1 behind a single load
# balancer), and make sure the app is reachable only through those proxies.
# Too high lets clients spoof their IP; too low puts every user in one proxy's
# bucket. With 0 (the default) the client IP is unknown, so the per-client rate
# limit is effectively off (a warning is logged once).
TRUST_PROXY_HOPS=0

# Proxy-wide cap on upstream Docker Hub requests per minute, retries included.
# Default 150; must not exceed 150 (Docker Hub anonymous limit is ~180/min per IP).
UPSTREAM_BUDGET_PER_MIN=150
